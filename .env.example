# Musoko runs with no .env at all. Demo mode is the default.
# Everything below is optional in demo mode.

# demo | live. Empty or absent means demo.
# NEXT_PUBLIC_DATA_MODE=demo

# Live mode only. These two are public by design; row-level security protects the data.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live mode only. Server side. Never prefix with NEXT_PUBLIC_. Never import into client code.
# SUPABASE_SERVICE_ROLE_KEY=
