# Musoko runs with this file empty. Demo mode is the default.

# demo | live
NEXT_PUBLIC_DATA_MODE=demo

# Map style. Defaults to OpenFreeMap, which needs no token.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Live mode only. Server side. Never prefix these with NEXT_PUBLIC_. ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
